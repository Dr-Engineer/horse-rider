extends Node
## Autoload: all audio. Owned by the Audio stream.
##
## Sfx.play(name, volume_db, pitch)            one-shot, no position (UI, the player's own sounds)
## Sfx.play_at(name, world_pos, volume_db, pitch)  one-shot with distance and pan from the active Camera3D
## Sfx.music("race" | "menu" | "final")        crossfades to a looping track
## Sfx.set_gallop(speed_fraction)              hoof loop for the player's gait (call every frame, 0 stops it)
## Sfx.set_ambience(wind, crowd)               0..1 loops for the race
## Sfx.set_music_volume(0..1), Sfx.set_sfx_volume(0..1), Sfx.set_voice_volume(0..1)   saved in the settings file by Game
##
## Voices (lines come from data/voice_bank.gd, files from assets/audio/voice/, both made by art/tools/make_voices.py):
## Sfx.say(speaker, category, world_pos = null, volume_db = 0.0, lang = "") -> Dictionary
##     A random line for that speaker and category, never one of the last few they said. world_pos is a Vector3, a Node3D
##     or a Callable returning a Vector3 for a voice that sits in the world (the last two follow a moving rider), or null
##     for a flat one. lang "bo" or "en" forces a language; "" follows Game.voice_language. Returns {f, t, g, l, d}
##     (file, subtitle, English gloss, language, seconds). With the voices muted (or the file not made yet) the line is
##     still picked and returned, just not played, so subtitles keep working. {} only when there is no such line.
## Sfx.say_text(speaker, text, volume_db = 0.0) -> float     an exact line a menu shows; seconds, or 0.0 if there is no file
##                                                          (with voices muted: the length, nothing played)
## Sfx.say_file(file, volume_db = 0.0) -> float              one voice file by name, e.g. a phrasebook entry's "f"
## Sfx.stop_voice(), Sfx.voice_playing() -> bool, var voice_volume
##
## Sounds are generated by art/tools/make_audio.py into assets/audio/<name>.wav; crowd shouts (cheer_*) are made by
## art/tools/make_voices.py into assets/audio/voice/<name>.ogg. A missing file is silently skipped.
##
## GAIN STRUCTURE. The sliders are linear 0..1 and set each bus to linear_to_db(slider), as they always have. Everything
## else is fixed here: the bus trims (BUS_DB), a loop trim per loop, one limiter on Master that only catches peaks, and
## ducking. At the default sliders (music 0.8, sfx 0.9, voice 0.85) a race measures about -20 LUFS, true peak under
## -1 dBFS, with voices about 3 to 4 dB above the mix and menus about -24 LUFS (tests/mix_check.gd measures this: run it
## with tools/run_hidden.ps1, which needs Movie Maker, and then read the recording with tests/mix_check.py).

const DIR := "res://assets/audio/"
const VOICE_DIR := "res://assets/audio/voice/"
const BANK_PATH := "res://data/voice_bank.gd"
const LOOPS: Array[String] = ["hooves_walk", "hooves_trot", "hooves_canter", "hooves_gallop", "wind", "crowd"]
const GAITS: Array[String] = ["hooves_walk", "hooves_trot", "hooves_canter", "hooves_gallop"]
const GAIT_NAMES: Array[String] = ["walk", "trot", "canter", "gallop"]
## Where each gait starts on the 0..1 speed scale (the same cut-offs RiderVisual uses for the horse animation), the strides
## per second each hoof loop was rendered at (art/tools/make_audio.py), and the speed a typical top-speed horse has.
const GAIT_START: Array[float] = [0.02, 0.12, 0.40, 0.74]
const LOOP_HZ: Array[float] = [1.2, 2.5, 2.55, 3.1]
const TYPICAL_TOP := 22.0

## Fixed gain, in dB, on top of the slider. The sounds themselves are normalised to their peak, so these set how loud each
## kind of thing sits in the mix. Tuned with tests/mix_check.gd (a bot race under Movie Maker, measured with pyloudnorm) at the
## default sliders: a race measures about -19 to -20 LUFS with a true peak of -2.0 dBFS (it was -8.6 LUFS and +0.6 dBTP with the old
## limiter's +5 dB of make-up gain), a voice speaking sits at -16.3 LUFS, about 4 dB above the mix, and a menu reads -24.8 LUFS
## (-23.4 with a spoken line in it). Music, the loops and the one-shots each add about the same to the race.
const BUS_DB := {"Music": 0.0, "SFX": 0.0, "Voice": 3.5}
const HOOF_DB := -13.0
const WIND_DB := -20.5
const CROWD_DB := -19.5
const ONESHOT_DB := -10.5              # every Sfx.play and play_at, on top of the volume the caller asks for
const MUSIC_DB := {"music_menu": -6.5, "music_race": -8.0, "music_final": -8.4}
const MUSIC_DEFAULT_DB := -7.0
const LIMITER_CEILING_DB := -2.0       # peaks only: the limiter never adds gain, and this keeps the true peak under -1 dBFS
const VOICE_DUCK_DB := -5.0            # music bus pulled down by this while anybody speaks
const DUCK_ATTACK := 12.0              # 1/s: full duck in about 80 ms
const DUCK_RELEASE := 2.0              # 1/s: back up over half a second
const DUCK_HOLD := 0.3                 # s: stay down between lines said close together

const ALIASES := {
	"hit": "hit_light", "punch": "hit_light", "slap": "hit_light", "thwack": "hit_light",
	"thud": "hit_heavy", "smash": "hit_heavy", "heavy": "hit_heavy",
	"block": "clang", "parry": "clang", "metal": "clang", "ding": "clang",
	"swing": "whoosh", "swish": "whoosh", "swoosh": "whoosh",
	"crack": "whip", "lash": "whip",
	"arrow": "bow_loose", "shoot": "bow_loose", "draw": "bow_draw",
	"stone": "sling", "throw": "rope", "haul": "rope",
	"fall": "crash", "unseat": "crash", "unseated": "crash", "down": "crash",
	"ok": "ui_ok", "confirm": "ui_ok", "move": "ui_move", "select": "ui_move", "back": "ui_back", "cancel": "ui_back",
	"tick": "count", "beep": "count", "start": "go", "gong": "cymbal",
	"scarf": "coin", "pickup": "coin", "silver": "coin",
	"flag": "flag_up", "lungta": "flag_up", "wind_burst": "second_wind",
	"mud": "splash", "water": "splash", "landing": "land", "leap": "land",
	"drum": "drum_hit", "dungchen": "horn",
	"bark": "dog_bark", "neigh": "whinny", "bleat": "sheep_bleat", "bray": "mule_bray", "crane": "crane_call",
	"marmot": "marmot_whistle", "pop": "hat_pop", "whiz": "near_miss", "bells": "harness_bells",
}

var music_volume := 0.8
var sfx_volume := 0.9
var voice_volume := 0.85

var _streams: Dictionary = {}
var _missing: Dictionary = {}
var _pool: Array[AudioStreamPlayer] = []
var _pool3d: Array[AudioStreamPlayer3D] = []
var _pool_i := 0
var _pool3d_i := 0
var _music_players: Array[AudioStreamPlayer] = []
var _music_live := 0
var _music_name := ""
var _music_tweens: Array[Tween] = [null, null]
var _loop_players: Dictionary = {}
var _loop_volume: Dictionary = {}      # name -> current linear volume
var _loop_target: Dictionary = {}      # name -> target linear volume
var _gait_rate := 1.0
var _gallop_age := 0.0
var _bus_music := -1
var _bus_sfx := -1
var _bus_voice := -1

# Voices
var _bank: Dictionary = {}              # VoiceBank.LINES, loaded the first time it is needed
var _bank_tried := false
var _voice_streams: Dictionary = {}     # file name -> AudioStream (kept small, see _voice_stream)
var _voice_missing: Dictionary = {}
var _voice_flat: Array[AudioStreamPlayer] = []
var _voice_3d: Array[AudioStreamPlayer3D] = []
var _voice_menu: AudioStreamPlayer
var _voice_follow: Dictionary = {}      # AudioStreamPlayer3D -> Node3D or Callable that gives its position
var _voice_born: Dictionary = {}        # flat player -> msec it started, to steal the oldest
var _recent: Dictionary = {}            # speaker -> last few file names said
var _rng := RandomNumberGenerator.new()
var _duck := 0.0                        # 0..1 how far the music is pulled down for speech
var _duck_hold := 0.0
var _duck_applied := -1.0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_rng.randomize()
	_bus_music = _ensure_bus("Music")
	_bus_sfx = _ensure_bus("SFX")
	_bus_voice = _ensure_bus("Voice")
	_ensure_limiter()
	var game := get_node_or_null("/root/Game")
	if game != null:
		music_volume = float(game.get("music_volume") if game.get("music_volume") != null else music_volume)
		sfx_volume = float(game.get("sfx_volume") if game.get("sfx_volume") != null else sfx_volume)
		voice_volume = float(game.get("voice_volume") if game.get("voice_volume") != null else voice_volume)
	_apply_volumes()
	for i in 12:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_pool.append(p)
	for i in 16:
		var p3 := AudioStreamPlayer3D.new()
		p3.bus = "SFX"
		p3.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
		p3.unit_size = 9.0
		p3.max_distance = 140.0
		p3.panning_strength = 1.2
		add_child(p3)
		_pool3d.append(p3)
	for i in 2:
		var m := AudioStreamPlayer.new()
		m.bus = "Music"
		m.volume_db = -80.0
		add_child(m)
		_music_players.append(m)
	for loop_name in LOOPS:
		var lp := AudioStreamPlayer.new()
		lp.bus = "SFX"
		lp.volume_db = -80.0
		lp.stream = _get_stream(loop_name, true)
		add_child(lp)
		_loop_players[loop_name] = lp
		_loop_volume[loop_name] = 0.0
		_loop_target[loop_name] = 0.0
	for i in 4:
		var v := AudioStreamPlayer.new()
		v.bus = "Voice"
		add_child(v)
		_voice_flat.append(v)
	for i in 6:
		var v3 := AudioStreamPlayer3D.new()
		v3.bus = "Voice"
		v3.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
		# A rival 30 m back must still be heard over the hooves, so the voice only starts to fall away beyond about 28 m,
		# and the near end is capped so a rider alongside isn't much louder than a flat voice.
		v3.unit_size = 28.0
		v3.max_db = 1.5
		v3.max_distance = 150.0
		v3.panning_strength = 1.0
		v3.attenuation_filter_cutoff_hz = 20500.0
		add_child(v3)
		_voice_3d.append(v3)
	_voice_menu = AudioStreamPlayer.new()
	_voice_menu.bus = "Voice"
	add_child(_voice_menu)


func _ensure_bus(bus_name: String) -> int:
	var i := AudioServer.get_bus_index(bus_name)
	if i < 0:
		AudioServer.add_bus()
		i = AudioServer.bus_count - 1
		AudioServer.set_bus_name(i, bus_name)
		AudioServer.set_bus_send(i, "Master")
	return i


## One limiter on the master bus that only catches peaks. (The old AudioEffectLimiter at threshold -6 and ceiling -1 added
## ceiling minus threshold, +5 dB, of make-up gain to everything and squashed the mix: that is removed.)
func _ensure_limiter() -> void:
	var master := AudioServer.get_bus_index("Master")
	for i in range(AudioServer.get_bus_effect_count(master) - 1, -1, -1):
		var fx := AudioServer.get_bus_effect(master, i)
		if fx is AudioEffectLimiter:
			AudioServer.remove_bus_effect(master, i)
		elif fx is AudioEffectHardLimiter:
			(fx as AudioEffectHardLimiter).ceiling_db = LIMITER_CEILING_DB
			(fx as AudioEffectHardLimiter).pre_gain_db = 0.0
			return
	var lim := AudioEffectHardLimiter.new()
	lim.ceiling_db = LIMITER_CEILING_DB
	lim.pre_gain_db = 0.0
	lim.release = 0.12
	AudioServer.add_bus_effect(master, lim)


func _bus_db(slider: float, bus_name: String) -> float:
	return linear_to_db(maxf(slider, 0.0001)) + float(BUS_DB.get(bus_name, 0.0))


func _apply_volumes() -> void:
	_duck_applied = _duck
	if _bus_music >= 0:
		AudioServer.set_bus_volume_db(_bus_music, _bus_db(music_volume, "Music") + VOICE_DUCK_DB * _duck_curve())
		AudioServer.set_bus_mute(_bus_music, music_volume <= 0.001)
	if _bus_sfx >= 0:
		AudioServer.set_bus_volume_db(_bus_sfx, _bus_db(sfx_volume, "SFX"))
		AudioServer.set_bus_mute(_bus_sfx, sfx_volume <= 0.001)
	if _bus_voice >= 0:
		AudioServer.set_bus_volume_db(_bus_voice, _bus_db(voice_volume, "Voice"))
		AudioServer.set_bus_mute(_bus_voice, voice_volume <= 0.001)


func _duck_curve() -> float:
	return _duck * _duck * (3.0 - 2.0 * _duck)


func set_music_volume(v: float) -> void:
	music_volume = clampf(v, 0.0, 1.0)
	_apply_volumes()
	var game := get_node_or_null("/root/Game")
	if game != null:
		game.set("music_volume", music_volume)


func set_sfx_volume(v: float) -> void:
	sfx_volume = clampf(v, 0.0, 1.0)
	_apply_volumes()
	var game := get_node_or_null("/root/Game")
	if game != null:
		game.set("sfx_volume", sfx_volume)


func set_voice_volume(v: float) -> void:
	voice_volume = clampf(v, 0.0, 1.0)
	_apply_volumes()
	var game := get_node_or_null("/root/Game")
	if game != null and game.get("voice_volume") != null:
		game.set("voice_volume", voice_volume)


## Where a sound lives: assets/audio/<name>.wav, or assets/audio/voice/<name>.ogg (the crowd shouts cheer_*).
func _sound_path(key: String) -> String:
	var wav := DIR + key + ".wav"
	if ResourceLoader.exists(wav):
		return wav
	var ogg := VOICE_DIR + key + ".ogg"
	if ResourceLoader.exists(ogg):
		return ogg
	return ""


func _get_stream(sound: String, looped: bool = false) -> AudioStream:
	var key := String(ALIASES.get(sound, sound))
	if _streams.has(key):
		return _streams[key]
	if _missing.has(key):
		return null
	var path := _sound_path(key)
	if path == "":
		_missing[key] = true
		return null
	var s := load(path) as AudioStream
	if s == null:
		_missing[key] = true
		return null
	if looped or key.begins_with("music_"):
		s = _make_loop(s)
	_streams[key] = s
	return s


func _make_loop(s: AudioStream) -> AudioStream:
	if s is AudioStreamWAV:
		var w := (s as AudioStreamWAV).duplicate() as AudioStreamWAV
		var frames := int(w.get_length() * float(w.mix_rate))
		w.loop_mode = AudioStreamWAV.LOOP_FORWARD
		w.loop_begin = 0
		w.loop_end = frames
		return w
	return s


func _next_player() -> AudioStreamPlayer:
	for k in _pool.size():
		var p := _pool[(_pool_i + k) % _pool.size()]
		if not p.playing:
			_pool_i = (_pool_i + k + 1) % _pool.size()
			return p
	_pool_i = (_pool_i + 1) % _pool.size()
	return _pool[_pool_i]


func _next_player3d() -> AudioStreamPlayer3D:
	for k in _pool3d.size():
		var p := _pool3d[(_pool3d_i + k) % _pool3d.size()]
		if not p.playing:
			_pool3d_i = (_pool3d_i + k + 1) % _pool3d.size()
			return p
	_pool3d_i = (_pool3d_i + 1) % _pool3d.size()
	return _pool3d[_pool3d_i]


func play(sound: String, volume_db: float = 0.0, pitch: float = 1.0) -> void:
	var s := _get_stream(sound)
	if s == null:
		return
	var p := _next_player()
	p.stream = s
	p.volume_db = volume_db + ONESHOT_DB
	p.pitch_scale = maxf(pitch, 0.05)
	p.play()


func play_at(sound: String, world_pos: Vector3, volume_db: float = 0.0, pitch: float = 1.0) -> void:
	var s := _get_stream(sound)
	if s == null:
		return
	var cam := get_viewport().get_camera_3d() if get_viewport() != null else null
	if cam == null:
		play(sound, volume_db - 6.0, pitch)
		return
	var p := _next_player3d()
	p.stream = s
	p.volume_db = volume_db + ONESHOT_DB
	p.pitch_scale = maxf(pitch, 0.05)
	p.global_position = world_pos
	p.play()


# ------------------------------------------------------------------ voices

func _lines() -> Dictionary:
	if not _bank_tried:
		_bank_tried = true
		# Loaded by path, so a missing or half-written data/voice_bank.gd only means a silent game.
		if ResourceLoader.exists(BANK_PATH):
			var script := load(BANK_PATH) as GDScript
			if script != null:
				var consts := script.get_script_constant_map()
				if consts.has("LINES"):
					_bank = consts["LINES"]
	return _bank


## A voice file by name (no extension), kept in a small cache so a long race doesn't hold every line it ever said.
func _voice_stream(file: String) -> AudioStream:
	if _voice_streams.has(file):
		return _voice_streams[file]
	if _voice_missing.has(file):
		return null
	var path := VOICE_DIR + file + ".ogg"
	if not ResourceLoader.exists(path):
		_voice_missing[file] = true
		return null
	var s := load(path) as AudioStream
	if s == null:
		_voice_missing[file] = true
		return null
	if _voice_streams.size() >= 96:
		_voice_streams.erase(_voice_streams.keys()[0])
	_voice_streams[file] = s
	return s


func _language() -> int:
	var game := get_node_or_null("/root/Game")
	if game != null and game.get("voice_language") != null:
		return int(game.get("voice_language"))
	return 0


func _pick_line(speaker: String, rows: Array, lang: String) -> Dictionary:
	var bo: Array = []
	var en: Array = []
	for r in rows:
		if (r as Dictionary).get("l", "en") == "bo":
			bo.append(r)
		else:
			en.append(r)
	var want := lang
	if want == "":
		match _language():
			1:
				want = "bo"
			2:
				want = "en"
			_:
				want = "bo" if (not bo.is_empty() and (en.is_empty() or _rng.randf() < 0.5)) else "en"
	var pool: Array = bo if want == "bo" else en
	if pool.is_empty():
		if lang != "":
			return {}     # a language that was asked for by name is not swapped for the other one
		pool = en if want == "bo" else bo
	if pool.is_empty():
		return {}
	var recent: Array = _recent.get(speaker, [])
	var fresh: Array = []
	for r in pool:
		if not recent.has((r as Dictionary)["f"]):
			fresh.append(r)
	if fresh.is_empty():
		for r in pool:
			if recent.is_empty() or (r as Dictionary)["f"] != recent[recent.size() - 1]:
				fresh.append(r)
	if fresh.is_empty():
		fresh = pool
	return fresh[_rng.randi() % fresh.size()]


func _remember(speaker: String, file: String) -> void:
	var recent: Array = _recent.get(speaker, [])
	recent.append(file)
	while recent.size() > 4:
		recent.pop_front()
	_recent[speaker] = recent


## True when voices are turned right down, or the Voice bus is muted some other way.
func _voice_muted() -> bool:
	return voice_volume <= 0.001 or (_bus_voice >= 0 and AudioServer.is_bus_mute(_bus_voice))


func _voice_flat_player() -> AudioStreamPlayer:
	var oldest: AudioStreamPlayer = _voice_flat[0]
	for p in _voice_flat:
		if not p.playing:
			return p
		if int(_voice_born.get(p, 0)) < int(_voice_born.get(oldest, 0)):
			oldest = p
	return oldest


func _voice_3d_player() -> AudioStreamPlayer3D:
	for p in _voice_3d:
		if not p.playing:
			return p
	return null


func _position_of(where: Variant) -> Variant:
	if where is Vector3:
		return where
	if where is Node3D and is_instance_valid(where):
		return (where as Node3D).global_position
	if where is Callable and (where as Callable).is_valid():
		var v: Variant = (where as Callable).call()
		if v is Vector3:
			return v
	return null


func say(speaker: String, category: String, world_pos: Variant = null, volume_db: float = 0.0, lang: String = "") -> Dictionary:
	var rows: Array = (_lines().get(speaker, {}) as Dictionary).get(category, [])
	if rows.is_empty():
		return {}
	var pick := _pick_line(speaker, rows, lang)
	if pick.is_empty():
		return {}
	var line: Dictionary = (pick as Dictionary).duplicate()
	_remember(speaker, String(pick["f"]))
	if _voice_muted():
		return line     # nothing plays, but the caller still gets the line for a subtitle (and its length from the bank)
	var stream := _voice_stream(String(pick["f"]))
	if stream == null:
		# That file isn't there (not generated or not imported yet): try the other lines before giving up.
		for r in rows:
			if (r as Dictionary)["f"] != pick["f"] and (lang == "" or (r as Dictionary).get("l", "en") == lang):
				var alt := _voice_stream(String((r as Dictionary)["f"]))
				if alt != null:
					pick = r
					line = (r as Dictionary).duplicate()
					stream = alt
					break
		if stream == null:
			return line     # no recording yet: still a line, so a subtitle can show
	line["d"] = stream.get_length()
	var where: Variant = _position_of(world_pos)
	var cam := get_viewport().get_camera_3d() if get_viewport() != null else null
	var p3 := _voice_3d_player() if (where != null and cam != null) else null
	if p3 != null:
		p3.stream = stream
		p3.volume_db = volume_db
		p3.global_position = where
		if world_pos is Node3D or world_pos is Callable:
			_voice_follow[p3] = world_pos
		else:
			_voice_follow.erase(p3)
		p3.play()
	else:
		# Flat: no position asked for, no camera to place it against, or all the positioned voices are busy.
		var p := _voice_flat_player()
		p.stream = stream
		p.volume_db = volume_db - (3.0 if world_pos != null else 0.0)
		_voice_born[p] = Time.get_ticks_msec()
		p.play()
	return line


## A line the menus show, spoken in that speaker's voice. The file is <speaker>_<first 8 hex of md5 of the text>.ogg.
## A new menu line cuts off the one before it. If there is no such file, the text is tried as a file name (the
## phrasebook's "f"), so either works.
func say_text(speaker: String, text: String, volume_db: float = 0.0) -> float:
	var file := "%s_%s" % [speaker, text.md5_text().substr(0, 8)]
	var stream := _voice_stream(file)
	if stream == null and text.is_valid_identifier():
		return say_file(text, volume_db)
	return _play_menu_voice(stream, volume_db)


func say_file(file: String, volume_db: float = 0.0) -> float:
	return _play_menu_voice(_voice_stream(file), volume_db)


func _play_menu_voice(stream: AudioStream, volume_db: float) -> float:
	if stream == null or _voice_menu == null:
		return 0.0
	if _voice_muted():
		return stream.get_length()     # silent, but the caller can still time its text by the length of the line
	_voice_menu.stream = stream
	_voice_menu.volume_db = volume_db
	_voice_menu.play()
	return stream.get_length()


func stop_voice() -> void:
	for p in _voice_flat:
		p.stop()
	for p3 in _voice_3d:
		p3.stop()
	_voice_follow.clear()
	if _voice_menu != null:
		_voice_menu.stop()


func voice_playing() -> bool:
	for p in _voice_flat:
		if p.playing:
			return true
	for p3 in _voice_3d:
		if p3.playing:
			return true
	return _voice_menu != null and _voice_menu.playing


# ------------------------------------------------------------------ music

## Track names: "menu", "race", "final" (or the full "music_race"). An empty string or stop_music() fades out.
func music(track: String) -> void:
	if track == "":
		stop_music()
		return
	var key := track if track.begins_with("music_") else "music_" + track
	if key == _music_name and _music_players[_music_live].playing:
		return
	var s := _get_stream(key, true)
	if s == null:
		return
	var old := _music_live
	var nxt := 1 - old
	_music_name = key
	_music_live = nxt
	var np := _music_players[nxt]
	np.stream = s
	np.volume_db = -60.0
	np.play()
	_fade_player(nxt, _music_level(), 1.4, false)
	_fade_player(old, -60.0, 1.4, true)


func _music_level() -> float:
	return float(MUSIC_DB.get(_music_name, MUSIC_DEFAULT_DB))


## Pull the music down while a menu is open over the race.
func duck(on: bool) -> void:
	for i in 2:
		if _music_players[i].playing and i == _music_live:
			_fade_player(i, _music_level() - (9.0 if on else 0.0), 0.3, false)


func stop_music() -> void:
	_music_name = ""
	for i in 2:
		_fade_player(i, -60.0, 0.8, true)


func _fade_player(i: int, to_db: float, secs: float, stop_after: bool) -> void:
	if _music_tweens[i] != null and _music_tweens[i].is_valid():
		_music_tweens[i].kill()
	var p := _music_players[i]
	if not p.playing and stop_after:
		return
	var tw := create_tween()
	tw.tween_property(p, "volume_db", to_db, secs)
	if stop_after:
		tw.tween_callback(p.stop)
	_music_tweens[i] = tw


## speed_fraction 0..1 of top speed, picks the hoof loop for the player's gait. Call every frame while racing.
## Each loop plays at the same cadence as the horse's legs (RiderVisual.cadence), so the sound stays with the feet.
func set_gallop(speed_fraction: float) -> void:
	_gallop_age = 0.0
	var f := clampf(speed_fraction, 0.0, 1.2)
	var edge := 0.025
	for i in GAITS.size():
		var lo := GAIT_START[i]
		var hi := GAIT_START[i + 1] if i + 1 < GAIT_START.size() else 1.3
		var weight := clampf(minf((f - lo) / edge, (hi - f) / edge) + 0.5, 0.0, 1.0)
		_loop_target[GAITS[i]] = weight
		if f >= lo - edge and f < hi + edge:
			var hz := RiderVisual.cadence(GAIT_NAMES[i], f * TYPICAL_TOP, TYPICAL_TOP)
			_loop_players[GAITS[i]].pitch_scale = clampf(hz / LOOP_HZ[i], 0.6, 1.4)


## 0..1 ambient loops for the race.
func set_ambience(wind: float, crowd: float) -> void:
	_loop_target["wind"] = clampf(wind, 0.0, 1.0)
	_loop_target["crowd"] = clampf(crowd, 0.0, 1.0)


## Silence the race loops (call when leaving a race).
func stop_loops() -> void:
	for n in LOOPS:
		_loop_target[n] = 0.0
	_gallop_age = 99.0


func _process(delta: float) -> void:
	_gallop_age += delta
	if _gallop_age > 0.5:   # the race stopped calling us, so the hooves stop
		for g in GAITS:
			_loop_target[g] = 0.0
	for n in LOOPS:
		var p := _loop_players[n] as AudioStreamPlayer
		if p.stream == null:
			continue
		var cur: float = _loop_volume[n]
		var tgt: float = _loop_target[n]
		cur = move_toward(cur, tgt, delta * (6.0 if n in GAITS else 1.2))
		_loop_volume[n] = cur
		var base := HOOF_DB if n in GAITS else (WIND_DB if n == "wind" else CROWD_DB)
		if cur <= 0.002:
			if p.playing:
				p.stop()
		else:
			if not p.playing:
				p.play()
			p.volume_db = base + linear_to_db(cur)
	_update_voices(delta)


func _update_voices(delta: float) -> void:
	# Voices that sit on a moving rider follow it.
	for p3: AudioStreamPlayer3D in _voice_follow.keys():
		if not p3.playing:
			_voice_follow.erase(p3)
			continue
		var where: Variant = _position_of(_voice_follow[p3])
		if where != null:
			p3.global_position = where
	# Music eases down while anybody speaks and back up a moment after.
	var speaking := voice_playing()
	if speaking:
		_duck_hold = DUCK_HOLD
	else:
		_duck_hold = maxf(_duck_hold - delta, 0.0)
	var goal := 1.0 if (speaking or _duck_hold > 0.0) else 0.0
	_duck = move_toward(_duck, goal, delta * (DUCK_ATTACK if goal > _duck else DUCK_RELEASE))
	if absf(_duck - _duck_applied) > 0.002:
		_apply_volumes()
