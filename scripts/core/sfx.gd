extends Node
## Autoload: all audio. Owned by the UI/meta agent.
##
## Sfx.play(name, volume_db, pitch)            one-shot, no position (UI, the player's own sounds)
## Sfx.play_at(name, world_pos, volume_db, pitch)  one-shot with distance and pan from the active Camera3D
## Sfx.music("race" | "menu" | "final")        crossfades to a looping track
## Sfx.set_gallop(speed_fraction)              hoof loop for the player's gait (call every frame, 0 stops it)
## Sfx.set_ambience(wind, crowd)               0..1 loops for the race
## Sfx.set_music_volume(0..1), Sfx.set_sfx_volume(0..1)   saved in the settings file by Game
##
## Sounds are generated by art/tools/make_audio.py into assets/audio/<name>.wav. A missing file is silently skipped.

const DIR := "res://assets/audio/"
const LOOPS: Array[String] = ["hooves_walk", "hooves_trot", "hooves_canter", "hooves_gallop", "wind", "crowd"]
const GAITS: Array[String] = ["hooves_walk", "hooves_trot", "hooves_canter", "hooves_gallop"]
## Where each gait starts on the 0..1 speed scale (the same cut-offs RiderVisual uses for the horse animation), the
## ground speed (m/s) at which that animation plays at normal speed, and the speed a typical top-speed horse has.
const GAIT_START: Array[float] = [0.02, 0.12, 0.40, 0.74]
const GAIT_REF: Array[float] = [1.7, 5.5, 9.0, 15.0]
const TYPICAL_TOP := 22.0
const HOOF_DB := 1.0
const WIND_DB := -9.0
const CROWD_DB := -8.0
const MUSIC_DB := -5.0
const ALIASES := {
	"hit": "hit_light", "punch": "hit_light", "slap": "hit_light", "thwack": "hit_light",
	"thud": "hit_heavy", "smash": "hit_heavy", "heavy": "hit_heavy",
	"block": "clang", "parry": "clang", "metal": "clang", "ding": "clang",
	"swing": "whoosh", "swish": "whoosh", "swoosh": "whoosh",
	"crack": "whip", "lash": "whip",
	"arrow": "bow_loose", "shoot": "bow_loose", "draw": "bow_draw",
	"stone": "sling", "throw": "rope", "haul": "rope",
	"fall": "crash", "unseat": "crash", "unseated": "crash", "down": "crash",
	"ok": "ui_ok", "confirm": "ui_ok", "move": "ui_move", "select": "ui_move", "back": "ui_back", "cancel": "ui_back",
	"tick": "count", "beep": "count", "start": "go", "gong": "cymbal",
	"scarf": "coin", "pickup": "coin", "silver": "coin",
	"flag": "flag_up", "lungta": "flag_up", "wind_burst": "second_wind",
	"mud": "splash", "water": "splash", "landing": "land", "leap": "land",
	"drum": "drum_hit", "dungchen": "horn",
}

var music_volume := 0.8
var sfx_volume := 0.9

var _streams: Dictionary = {}
var _missing: Dictionary = {}
var _pool: Array[AudioStreamPlayer] = []
var _pool3d: Array[AudioStreamPlayer3D] = []
var _pool_i := 0
var _pool3d_i := 0
var _music_players: Array[AudioStreamPlayer] = []
var _music_live := 0
var _music_name := ""
var _music_tweens: Array[Tween] = [null, null]
var _loop_players: Dictionary = {}
var _loop_volume: Dictionary = {}      # name -> current linear volume
var _loop_target: Dictionary = {}      # name -> target linear volume
var _gait_rate := 1.0
var _gallop_age := 0.0
var _bus_music := -1
var _bus_sfx := -1


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_bus_music = _ensure_bus("Music")
	_bus_sfx = _ensure_bus("SFX")
	_ensure_limiter()
	var game := get_node_or_null("/root/Game")
	if game != null:
		music_volume = float(game.get("music_volume") if game.get("music_volume") != null else music_volume)
		sfx_volume = float(game.get("sfx_volume") if game.get("sfx_volume") != null else sfx_volume)
	_apply_volumes()
	for i in 12:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_pool.append(p)
	for i in 16:
		var p3 := AudioStreamPlayer3D.new()
		p3.bus = "SFX"
		p3.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
		p3.unit_size = 9.0
		p3.max_distance = 140.0
		p3.panning_strength = 1.2
		add_child(p3)
		_pool3d.append(p3)
	for i in 2:
		var m := AudioStreamPlayer.new()
		m.bus = "Music"
		m.volume_db = -80.0
		add_child(m)
		_music_players.append(m)
	for loop_name in LOOPS:
		var lp := AudioStreamPlayer.new()
		lp.bus = "SFX"
		lp.volume_db = -80.0
		lp.stream = _get_stream(loop_name, true)
		add_child(lp)
		_loop_players[loop_name] = lp
		_loop_volume[loop_name] = 0.0
		_loop_target[loop_name] = 0.0


func _ensure_bus(bus_name: String) -> int:
	var i := AudioServer.get_bus_index(bus_name)
	if i < 0:
		AudioServer.add_bus()
		i = AudioServer.bus_count - 1
		AudioServer.set_bus_name(i, bus_name)
		AudioServer.set_bus_send(i, "Master")
	return i


## A limiter on the master bus, so a pile-up of hits, hooves and music can't clip.
func _ensure_limiter() -> void:
	var master := AudioServer.get_bus_index("Master")
	for i in AudioServer.get_bus_effect_count(master):
		if AudioServer.get_bus_effect(master, i) is AudioEffectLimiter:
			return
	var lim := AudioEffectLimiter.new()
	lim.ceiling_db = -1.0
	lim.threshold_db = -6.0
	lim.soft_clip_db = 2.0
	AudioServer.add_bus_effect(master, lim)


func _apply_volumes() -> void:
	if _bus_music >= 0:
		AudioServer.set_bus_volume_db(_bus_music, linear_to_db(maxf(music_volume, 0.0001)))
		AudioServer.set_bus_mute(_bus_music, music_volume <= 0.001)
	if _bus_sfx >= 0:
		AudioServer.set_bus_volume_db(_bus_sfx, linear_to_db(maxf(sfx_volume, 0.0001)))
		AudioServer.set_bus_mute(_bus_sfx, sfx_volume <= 0.001)


func set_music_volume(v: float) -> void:
	music_volume = clampf(v, 0.0, 1.0)
	_apply_volumes()
	var game := get_node_or_null("/root/Game")
	if game != null:
		game.set("music_volume", music_volume)


func set_sfx_volume(v: float) -> void:
	sfx_volume = clampf(v, 0.0, 1.0)
	_apply_volumes()
	var game := get_node_or_null("/root/Game")
	if game != null:
		game.set("sfx_volume", sfx_volume)


func _get_stream(sound: String, looped: bool = false) -> AudioStream:
	var key := String(ALIASES.get(sound, sound))
	if _streams.has(key):
		return _streams[key]
	if _missing.has(key):
		return null
	var path := DIR + key + ".wav"
	if not ResourceLoader.exists(path):
		_missing[key] = true
		return null
	var s := load(path) as AudioStream
	if s == null:
		_missing[key] = true
		return null
	if looped or key.begins_with("music_"):
		s = _make_loop(s)
	_streams[key] = s
	return s


func _make_loop(s: AudioStream) -> AudioStream:
	if s is AudioStreamWAV:
		var w := (s as AudioStreamWAV).duplicate() as AudioStreamWAV
		var frames := int(w.get_length() * float(w.mix_rate))
		w.loop_mode = AudioStreamWAV.LOOP_FORWARD
		w.loop_begin = 0
		w.loop_end = frames
		return w
	return s


func _next_player() -> AudioStreamPlayer:
	for k in _pool.size():
		var p := _pool[(_pool_i + k) % _pool.size()]
		if not p.playing:
			_pool_i = (_pool_i + k + 1) % _pool.size()
			return p
	_pool_i = (_pool_i + 1) % _pool.size()
	return _pool[_pool_i]


func _next_player3d() -> AudioStreamPlayer3D:
	for k in _pool3d.size():
		var p := _pool3d[(_pool3d_i + k) % _pool3d.size()]
		if not p.playing:
			_pool3d_i = (_pool3d_i + k + 1) % _pool3d.size()
			return p
	_pool3d_i = (_pool3d_i + 1) % _pool3d.size()
	return _pool3d[_pool3d_i]


func play(sound: String, volume_db: float = 0.0, pitch: float = 1.0) -> void:
	var s := _get_stream(sound)
	if s == null:
		return
	var p := _next_player()
	p.stream = s
	p.volume_db = volume_db
	p.pitch_scale = maxf(pitch, 0.05)
	p.play()


func play_at(sound: String, world_pos: Vector3, volume_db: float = 0.0, pitch: float = 1.0) -> void:
	var s := _get_stream(sound)
	if s == null:
		return
	var cam := get_viewport().get_camera_3d() if get_viewport() != null else null
	if cam == null:
		play(sound, volume_db - 6.0, pitch)
		return
	var p := _next_player3d()
	p.stream = s
	p.volume_db = volume_db
	p.pitch_scale = maxf(pitch, 0.05)
	p.global_position = world_pos
	p.play()


## Track names: "menu", "race", "final" (or the full "music_race"). An empty string or stop_music() fades out.
func music(track: String) -> void:
	if track == "":
		stop_music()
		return
	var key := track if track.begins_with("music_") else "music_" + track
	if key == _music_name and _music_players[_music_live].playing:
		return
	var s := _get_stream(key, true)
	if s == null:
		return
	var old := _music_live
	var nxt := 1 - old
	_music_name = key
	_music_live = nxt
	var np := _music_players[nxt]
	np.stream = s
	np.volume_db = -60.0
	np.play()
	_fade_player(nxt, MUSIC_DB, 1.4, false)
	_fade_player(old, -60.0, 1.4, true)


## Pull the music down while a menu is open over the race.
func duck(on: bool) -> void:
	for i in 2:
		if _music_players[i].playing and i == _music_live:
			_fade_player(i, MUSIC_DB - (9.0 if on else 0.0), 0.3, false)


func stop_music() -> void:
	_music_name = ""
	for i in 2:
		_fade_player(i, -60.0, 0.8, true)


func _fade_player(i: int, to_db: float, secs: float, stop_after: bool) -> void:
	if _music_tweens[i] != null and _music_tweens[i].is_valid():
		_music_tweens[i].kill()
	var p := _music_players[i]
	if not p.playing and stop_after:
		return
	var tw := create_tween()
	tw.tween_property(p, "volume_db", to_db, secs)
	if stop_after:
		tw.tween_callback(p.stop)
	_music_tweens[i] = tw


## speed_fraction 0..1 of top speed, picks the hoof loop for the player's gait. Call every frame while racing.
## The loops are as long as the horse's own stride animations, so playing them faster as the horse speeds up keeps
## the sound with the feet.
func set_gallop(speed_fraction: float) -> void:
	_gallop_age = 0.0
	var f := clampf(speed_fraction, 0.0, 1.2)
	var edge := 0.025
	for i in GAITS.size():
		var lo := GAIT_START[i]
		var hi := GAIT_START[i + 1] if i + 1 < GAIT_START.size() else 1.3
		var weight := clampf(minf((f - lo) / edge, (hi - f) / edge) + 0.5, 0.0, 1.0)
		_loop_target[GAITS[i]] = weight
		if f >= lo - edge and f < hi + edge:
			var anim_scale := clampf(f * TYPICAL_TOP / GAIT_REF[i], 0.5, 1.9)
			_loop_players[GAITS[i]].pitch_scale = clampf(1.0 + 0.6 * (anim_scale - 1.0), 0.75, 1.5)


## 0..1 ambient loops for the race.
func set_ambience(wind: float, crowd: float) -> void:
	_loop_target["wind"] = clampf(wind, 0.0, 1.0)
	_loop_target["crowd"] = clampf(crowd, 0.0, 1.0)


## Silence the race loops (call when leaving a race).
func stop_loops() -> void:
	for n in LOOPS:
		_loop_target[n] = 0.0
	_gallop_age = 99.0


func _process(delta: float) -> void:
	_gallop_age += delta
	if _gallop_age > 0.5:   # the race stopped calling us, so the hooves stop
		for g in GAITS:
			_loop_target[g] = 0.0
	for n in LOOPS:
		var p := _loop_players[n] as AudioStreamPlayer
		if p.stream == null:
			continue
		var cur: float = _loop_volume[n]
		var tgt: float = _loop_target[n]
		cur = move_toward(cur, tgt, delta * (6.0 if n in GAITS else 1.2))
		_loop_volume[n] = cur
		var base := HOOF_DB if n in GAITS else (WIND_DB if n == "wind" else CROWD_DB)
		if cur <= 0.002:
			if p.playing:
				p.stop()
		else:
			if not p.playing:
				p.play()
			p.volume_db = base + linear_to_db(cur)
